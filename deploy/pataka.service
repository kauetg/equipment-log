# systemd — Pataka no Raspberry Pi.
# Ajuste User e os caminhos (/home/pi/pataka) e instale com:
#   sudo cp deploy/pataka.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pataka
#   journalctl -u pataka -f      # logs
[Unit]
Description=Pataka (Equipment Log)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/pataka
EnvironmentFile=/home/pi/pataka/.env
# 127.0.0.1 = só o proxy (nginx/Caddy/cloudflared) enxerga; use 0.0.0.0 pra abrir na rede local
ExecStart=/home/pi/pataka/.venv/bin/gunicorn run:app --bind 127.0.0.1:5006 --workers 2 --threads 4 --timeout 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
