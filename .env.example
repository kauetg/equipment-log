# Mesmo cluster Atlas do guardiola, database separado (ver PLANO.md §8)
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
MONGO_DB_NAME=equipment_log
SECRET_KEY=troque-isso

# Arquivos (fotos, recibos, manuais) — só arquivos, dados ficam no Mongo. Configure UM:
#
# (a) Cloudinary — grátis, sem cartão. Dashboard > API Keys > "API environment variable".
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=equipment-log   # pasta do app na conta (a conta pode ter outros apps)
#
# (b) S3-compatível (Cloudflare R2 / Backblaze B2 / AWS S3) — descomente e preencha.
# S3_BUCKET=equipment-log
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
#
# Sem nenhum dos dois, os arquivos vão pro GridFS (dentro do Mongo).

# 🌱 Integrações futuras (desligadas por padrão)
GUARDIOLA_DB_NAME=finance_app
INTEGRATION_GUARDIOLA=0
INTEGRATION_MEDIA_LOGGER=0
